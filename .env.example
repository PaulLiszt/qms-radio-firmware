# 环境变量示例（复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不会进仓库）
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# 管理员种子密码（仅「全新部署、且 data/users.json 为空」时用于首次播种 ADMIN 账户）。
# 若云端 data/users.json 已存在 ADMIN，则不会重跑播种，此值不影响现成登录。
# 请设置一个强密码，不要使用本示例值。
ADMIN_PASSWORD=change_me_strong_password

# 邮件发信配置（可选；留空则使用代码内默认域名邮箱）
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_USER=your_mail_user
# MAIL_PASS=your_mail_password
# MAIL_FROM=noreply@ba4qms.top
# ADMIN_EMAIL=admin@ba4qms.top
